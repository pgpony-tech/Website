---
layout: layout.njk
title: Help
permalink: /volunteer/
---
{% from "components/breadcrumbs.njk" import breadcrumbs %}
{% from "components/section-heading.njk" import sectionHeading %}
{% from "components/card.njk" import card %}
{% from "components/button.njk" import button %}

{% set roles = [
  { title: "Head coach", hours: "Practices and games, weekly", description: "Run practices, set the lineup, and lead your team all season. Background check and PG PONY training completion required." },
  { title: "Assistant coach", hours: "Practices and games, weekly", description: "Support the head coach at practices and games. Background check and PG PONY training completion required." },
  { title: "Team parent", hours: "~2 hrs / week", description: "Coordinate snack schedule, photo day, and end-of-season party for one team." },
  { title: "Scorekeeper", hours: "1-2 games / week", description: "Keep score from the stands using GameChanger. New to it? Check out <a href=\"https://www.youtube.com/watch?v=zIMtvL_4sdQ&amp;list=PLwYgAwI9eXuaQZh0-oPqxYQOcwqdv8I7g\" target=\"_blank\" rel=\"noopener\">GameChanger University</a> on YouTube." },
  { title: "Concessions", hours: "2 shifts / season", description: "3-4 families run Concessions together for each home game — 30 minutes before first pitch to 30 minutes after the last out. The PG PONY Concessions Team will train you." },
  { title: "Field prep", hours: "Before and after each game", description: "Drag and line the infield before first pitch and break it down after the last out. We'll train you — it takes about 45 minutes." },
  { title: "Board member", hours: "Monthly", description: "The board meets monthly. <a href=\"/board/?vacant=1\">See which board roles are vacant</a> and how to get involved." }
] %}

<div class="page-header page-header--black">
  <div class="page-header__watermark">
    <img src="/assets/logos/symbol-color-light.png" alt="">
  </div>
  <div class="page-header__inner">
    {{ breadcrumbs([{ label: "Home", href: "/" }, { label: "Help" }]) }}
    <h1>The league is the parents</h1>
    <p>Nobody here is paid. Every practice, every lined field, every hot dog is a parent who showed up. Pick a job that fits your season.</p>
  </div>
</div>

<div class="container" style="padding-top:var(--space-12);padding-bottom:var(--space-12);">
  {{ sectionHeading(
    eyebrow="Open roles",
    title="Where we need hands",
    description="Every role is filled per team. Sign up when you register your player, or log in above if you've already registered — we'll match you to your child's team based on need."
  ) }}
  <div class="grid-3">
    {% for role in roles %}
    {% call card() %}
    <h3 class="role-card__title">{{ role.title }}</h3>
    <span class="role-card__hours">{{ role.hours }}</span>
    <p class="role-card__desc" style="margin:0;">{{ role.description | safe }}</p>
    {% endcall %}
    {% endfor %}
  </div>

  <div class="mt-9"></div>
  {% call card(variant="brand") %}
  <h3 style="text-transform:uppercase;color:var(--pg-gold);">Thinking about coaching?</h3>
  <p style="margin:0 0 var(--space-4);">Read our coaching philosophy — what we ask of coaches, and what your players and their families can expect from you.</p>
  {{ button(label="View our coaching philosophy", href="/coaching-philosophy/", variant="inverse", size="sm") }}
  {% endcall %}

  <div class="grid-2 mt-11">
    {% call card(accentBar=true) %}
    <h3 style="text-transform:uppercase;">Board of Directors</h3>
    <p style="margin:0 0 var(--space-4);">PG PONY is run by an all-volunteer board. See who's who and how to reach each of them.</p>
    {{ button(label="Meet the board", href="/board/", variant="secondary", size="sm") }}
    {% endcall %}
    {% call card(accentBar=true) %}
    <h3 style="text-transform:uppercase;">Need help?</h3>
    <p style="margin:0 0 var(--space-4);">Have a specific question? Tell us what you need and we'll help you find the right person.</p>
    {{ button(label="Get help", href="/contact/", variant="secondary", size="sm") }}
    {% endcall %}
  </div>
</div>
