---
layout: layout.njk
title: Volunteer
permalink: /volunteer/
---
{% from "components/button.njk" import button %}
{% from "components/badge.njk" import badge %}
{% from "components/breadcrumbs.njk" import breadcrumbs %}
{% from "components/section-heading.njk" import sectionHeading %}
{% from "components/standings-table.njk" import standingsTable %}
{% from "components/card.njk" import card %}

{% set roles = [
  { title: "Team parent", hours: "~2 hrs / week", description: "Coordinate snack schedule, photo day, and end-of-season party for one team.", open: 4 },
  { title: "Scorekeeper", hours: "1 game / week", description: "Keep the book from the dugout. We'll train you in fifteen minutes.", open: 9 },
  { title: "Snack bar", hours: "2 shifts / season", description: "Every family takes two. Shifts run the length of one game.", open: 22 },
  { title: "Field prep", hours: "Saturday mornings", description: "Drag and line the infield before first pitch. Equipment provided.", open: 6 },
  { title: "Umpire", hours: "Paid, ages 14+", description: "PONY-certified training in February. A great first job for older players.", open: 5 },
  { title: "Board member", hours: "Third Thursday, monthly", description: "Meetings are open to the public. Open seats posted each fall.", open: 2 }
] %}

<div class="page-header page-header--black">
  <div class="page-header__watermark">
    <img src="/assets/logos/symbol-color-light.png" alt="">
  </div>
  <div class="page-header__inner">
    {{ breadcrumbs([{ label: "Home", href: "/" }, { label: "Volunteer" }]) }}
    <h1>The league is the parents</h1>
    <p>Nobody here is paid. Every practice, every lined field, every hot dog is a parent who showed up. Pick a job that fits your season.</p>
  </div>
</div>

<div class="container" style="padding-top:var(--space-12);padding-bottom:var(--space-12);">
  {{ sectionHeading(
    eyebrow="Open roles",
    title="Where we need hands",
    description="Numbers show open spots for spring 2026."
  ) }}
  <div class="grid-3">
    {% for role in roles %}
    {% call card(interactive=true) %}
    <div class="role-card__head">
      <h3 class="role-card__title">{{ role.title }}</h3>
      {{ badge(label=role.open ~ " open", tone=("gold" if role.open > 10 else "neutral"), size="sm") }}
    </div>
    <span class="role-card__hours">{{ role.hours }}</span>
    <p class="role-card__desc">{{ role.description }}</p>
    {{ button(label="Sign up", href=site.sportsConnectUrl, variant="secondary", size="sm", external=true) }}
    {% endcall %}
    {% endfor %}
  </div>

  <div class="mt-11" id="board">
    {{ sectionHeading(eyebrow="2026 board", title="Who to call") }}
    {{ standingsTable(
      columns=[
        { key: "role", label: "Role" },
        { key: "name", label: "Name" },
        { key: "email", label: "Email" }
      ],
      rows=[
        { role: "General inquiries", name: "—", email: site.email },
        { role: "President", name: "—", email: site.email },
        { role: "Registrar", name: "—", email: site.email },
        { role: "Player agent", name: "—", email: site.email },
        { role: "Treasurer", name: "—", email: site.email }
      ]
    ) }}
    <p class="text-faint" style="margin-top:var(--space-3);">Board names are updated each fall — email {{ site.email }} to reach any board role now. Meetings are the third Thursday of every month and open to the public.</p>
  </div>
</div>
