---
layout: layout.njk
title: Divisions
permalink: /divisions/
---
{% from "components/button.njk" import button %}
{% from "components/breadcrumbs.njk" import breadcrumbs %}
{% from "components/section-heading.njk" import sectionHeading %}
{% from "components/division-card.njk" import divisionCard %}
{% from "components/standings-table.njk" import standingsTable %}
{% from "components/card.njk" import card %}

<div class="page-header">
  <div class="page-header__inner">
    {{ breadcrumbs([{ label: "Home", href: "/" }, { label: "Divisions" }]) }}
    <h1>Divisions</h1>
    <p>We field separate baseball and softball programs, each broken into age divisions. Baseball uses {{ site.baseballAgeCutoff }} as the age cutoff; softball uses {{ site.softballAgeCutoff }}, which lines up with the school district's cutoff. If you're unsure, register anyway and we'll sort it out.</p>
  </div>
</div>

<div class="container" style="padding-top:var(--space-10);padding-bottom:var(--space-12);">
  {{ sectionHeading(eyebrow="Coed", title="Baseball divisions") }}
  <div class="grid-3 mb-9">
    {% for division in site.baseballDivisions %}
      {{ divisionCard(division) }}
    {% endfor %}
  </div>

  <div class="mt-11">
    {{ sectionHeading(eyebrow="Girls", title="Softball divisions") }}
    <!-- 6U is a new division, added at the board's request as the softball equivalent of tee ball.
         Its age range and typical grade are an estimate pending board confirmation — the other four
         softball divisions (Pre-Rookie through Major) are pulled directly from pgpony.com. -->
    <div class="grid-3">
      {% for division in site.softballDivisions %}
        {{ divisionCard(division) }}
      {% endfor %}
    </div>
  </div>

  <div class="mt-11">
    {{ sectionHeading(
      eyebrow="Season so far",
      title="Mustang standings",
      actionHtml=button(label="All divisions", href="/schedule/", variant="ghost", size="sm")
    ) }}
    {{ standingsTable(
      columns=[
        { key: "team", label: "Team" },
        { key: "w", label: "W", align: "right" },
        { key: "l", label: "L", align: "right" },
        { key: "pct", label: "Pct", align: "right" },
        { key: "rs", label: "RS", align: "right" },
        { key: "ra", label: "RA", align: "right" }
      ],
      rows=[
        { team: "Sea Otters", w: 8, l: 2, pct: ".800", rs: 64, ra: 38 },
        { team: "Cardinals", w: 6, l: 4, pct: ".600", rs: 52, ra: 47 },
        { team: "Kelp", w: 5, l: 5, pct: ".500", rs: 49, ra: 51 },
        { team: "Monarchs", w: 3, l: 7, pct: ".300", rs: 41, ra: 58 },
        { team: "Lighthouse", w: 3, l: 7, pct: ".300", rs: 36, ra: 60 }
      ]
    ) }}
  </div>

  <div class="mt-9">
    {% call card(variant="sunken") %}
    <div class="flex-between">
      <div>
        <h3 style="text-transform:uppercase;">Not sure where your player fits?</h3>
        <p class="text-muted" style="margin:0;">Email {{ site.email }} and a division rep will call you back.</p>
      </div>
      {{ button(label="Contact the board", href="/volunteer/", variant="secondary") }}
    </div>
    {% endcall %}
  </div>
</div>
