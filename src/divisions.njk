---
layout: layout.njk
title: Divisions
permalink: /divisions/
extraScripts:
  - /js/tabs.js
---
{% from "components/button.njk" import button %}
{% from "components/breadcrumbs.njk" import breadcrumbs %}
{% from "components/tabs.njk" import tabs %}
{% from "components/section-heading.njk" import sectionHeading %}
{% from "components/standings-table.njk" import standingsTable %}
{% from "components/card.njk" import card %}

{% set allstarDivisions = ["Mustang", "Bronco", "Pony", "Fillies"] %}

<div class="page-header">
  <div class="page-header__inner">
    {{ breadcrumbs([{ label: "Home", href: "/" }, { label: "Divisions" }]) }}
    <h1>Divisions</h1>
    <p>League age is your player's age on April 30 of the current season. If you're unsure, register anyway and we'll sort it out.</p>
  </div>
</div>

<div class="container" style="padding-top:var(--space-8);padding-bottom:var(--space-12);">
  {{ tabs(
    items=[
      { label: "Baseball", value: "baseball" },
      { label: "Softball", value: "softball" },
      { label: "All-Stars", value: "allstar" }
    ],
    groupName="sport",
    activeValue="baseball"
  ) }}
  <div class="mt-9"></div>

  <div class="grid-3">
    {% for division in site.divisions %}
    <a
      class="division-card"
      href="/divisions/"
      data-sport="{{ 'softball' if division.name == 'Fillies' else 'baseball softball' }}"
      data-allstar="{{ 'true' if division.name in allstarDivisions else 'false' }}"
    >
      <div class="division-card__head">
        <span class="division-card__name">{{ division.name }}</span>
        <span class="division-card__ages">{{ division.ages }}</span>
      </div>
      <div class="division-card__body">
        <span class="division-card__sport">{{ division.sport }}</span>
        <p class="division-card__desc">{{ division.description }}</p>
        <ul class="division-card__detail">
          {% for d in division.detail %}<li>{{ d }}</li>{% endfor %}
        </ul>
      </div>
    </a>
    {% endfor %}
  </div>

  <div class="mt-11">
    {{ sectionHeading(
      eyebrow="Season so far",
      title="Mustang standings",
      actionHtml=button(label="All divisions", href="/schedule/", variant="ghost", size="sm")
    ) }}
    {{ standingsTable(
      columns=[
        { key: "team", label: "Team" },
        { key: "w", label: "W", align: "right" },
        { key: "l", label: "L", align: "right" },
        { key: "pct", label: "Pct", align: "right" },
        { key: "rs", label: "RS", align: "right" },
        { key: "ra", label: "RA", align: "right" }
      ],
      rows=[
        { team: "Sea Otters", w: 8, l: 2, pct: ".800", rs: 64, ra: 38 },
        { team: "Cardinals", w: 6, l: 4, pct: ".600", rs: 52, ra: 47 },
        { team: "Kelp", w: 5, l: 5, pct: ".500", rs: 49, ra: 51 },
        { team: "Monarchs", w: 3, l: 7, pct: ".300", rs: 41, ra: 58 },
        { team: "Lighthouse", w: 3, l: 7, pct: ".300", rs: 36, ra: 60 }
      ]
    ) }}
  </div>

  <div class="mt-9">
    {% call card(variant="sunken") %}
    <div class="flex-between">
      <div>
        <h3 style="text-transform:uppercase;">Not sure where your player fits?</h3>
        <p class="text-muted" style="margin:0;">Email {{ site.email }} and a division rep will call you back.</p>
      </div>
      {{ button(label="Contact the board", href="/volunteer/", variant="secondary") }}
    </div>
    {% endcall %}
  </div>
</div>
