---
layout: layout.njk
title: Divisions
permalink: /divisions/
extraScripts:
  - /js/age-calculator.js
---
{% from "components/breadcrumbs.njk" import breadcrumbs %}
{% from "components/section-heading.njk" import sectionHeading %}
{% from "components/division-card.njk" import divisionCard %}
{% from "components/card.njk" import card %}

<div class="page-header">
  <div class="page-header__inner">
    {{ breadcrumbs([{ label: "Home", href: "/" }, { label: "Divisions" }]) }}
    <h1>Divisions</h1>
    <p>We field separate baseball and softball programs, each broken into age divisions. Baseball uses {{ site.baseballAgeCutoff }} as the age cutoff; softball uses {{ site.softballAgeCutoff }}, which lines up with the school district's cutoff. If you're unsure, register anyway and we'll sort it out.</p>
  </div>
</div>

<div class="container" style="padding-top:var(--space-10);padding-bottom:var(--space-12);">
  {{ sectionHeading(eyebrow="Coed", title="Baseball divisions", description="Baseball is predominantly boys, but open to girls as well.") }}
  <div class="grid-3 mb-9">
    {% for division in site.baseballDivisions %}
      {{ divisionCard(division) }}
    {% endfor %}
  </div>

  <div class="mt-11">
    {{ sectionHeading(eyebrow="Girls", title="Softball divisions") }}
    <div class="grid-3">
      {% for division in site.softballDivisions %}
        {{ divisionCard(division) }}
      {% endfor %}
    </div>
  </div>

  <div class="mt-11">
    {{ sectionHeading(
      eyebrow="Find your division",
      title="Age calculator",
      description="Enter your player's date of birth to see which division they fall into for the upcoming season."
    ) }}
    {% call card() %}
    <div class="age-calc" data-age-calc>
      <div class="age-calc__toggle" role="tablist">
        <button type="button" class="age-calc__sport-btn is-active" data-sport="baseball" role="tab" aria-pressed="true">Baseball</button>
        <button type="button" class="age-calc__sport-btn" data-sport="softball" role="tab" aria-pressed="false">Softball</button>
      </div>
      <p class="age-calc__note" data-sport-note>Coed — predominantly boys, but open to girls as well.</p>

      <div class="age-calc__field">
        <label class="field__label" for="age-calc-mm">Player's date of birth</label>
        <div class="age-calc__dob-group">
          <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="2" class="input age-calc__dob-part" id="age-calc-mm" data-dob-part="mm" placeholder="MM" aria-label="Birth month">
          <span class="age-calc__dob-sep">/</span>
          <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="2" class="input age-calc__dob-part" data-dob-part="dd" placeholder="DD" aria-label="Birth day">
          <span class="age-calc__dob-sep">/</span>
          <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="4" class="input age-calc__dob-part age-calc__dob-part--year" data-dob-part="yyyy" placeholder="YYYY" aria-label="Birth year">
        </div>
      </div>

      <div class="age-calc__result" data-result hidden></div>
    </div>
    {% endcall %}
  </div>
</div>
