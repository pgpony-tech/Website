---
layout: layout.njk
title: Schedule & scores
permalink: /schedule/
extraScripts:
  - /js/tabs.js
  - /js/schedule.js
---
{% from "components/button.njk" import button %}
{% from "components/breadcrumbs.njk" import breadcrumbs %}
{% from "components/tabs.njk" import tabs %}
{% from "components/tag.njk" import tag %}
{% from "components/alert.njk" import alert %}
{% from "components/game-card.njk" import gameCard %}
{% from "components/card.njk" import card %}

{% set games = [
  { date: "SAT 3/14", time: "8:30 AM", division: "Shetland", away: "Sandpipers", home: "Tide", field: "Arnett Park", status: "final" },
  { date: "SAT 3/14", time: "10:00 AM", division: "Pinto", away: "Cardinals", home: "Sea Otters", field: "George Washington Park · Field 2", status: "final", score: "7–4" },
  { date: "SAT 3/14", time: "1:00 PM", division: "Mustang", away: "Monarchs", home: "Kelp", field: "Muni Ballpark", status: "live", score: "2–2" },
  { date: "SAT 3/14", time: "3:30 PM", division: "Bronco", away: "Lighthouse", home: "Anglers", field: "George Washington Park · Field 1", status: "scheduled" },
  { date: "SUN 3/15", time: "9:00 AM", division: "Fillies", away: "Breakers", home: "Cypress", field: "Arnett Park", status: "scheduled" },
  { date: "SUN 3/15", time: "11:30 AM", division: "Pony", away: "Monterey Bay", home: "Grove", field: "Muni Ballpark", status: "cancelled" }
] %}
{% set divisionTags = ["All", "Shetland", "Pinto", "Mustang", "Bronco", "Pony", "Fillies"] %}

<div class="page-header">
  <div class="page-header__inner">
    {{ breadcrumbs([{ label: "Home", href: "/" }, { label: "Schedule" }]) }}
    <h1>Schedule &amp; scores</h1>
  </div>
</div>

<div class="container" style="padding-top:var(--space-8);padding-bottom:var(--space-12);">
  <div class="with-sidebar">
    <div>
      {{ alert(
        title="Field status",
        message="Sunday morning games may be delayed. Field status for George Washington Park, Muni Ballpark and Arnett Park is updated by 7:00 AM.",
        tone="warning"
      ) }}
      <div style="height:var(--space-7);"></div>

      {{ tabs(
        items=[
          { label: "This week", value: "w" },
          { label: "Full season", value: "s" },
          { label: "Results", value: "r" }
        ],
        groupName="range",
        activeValue="w"
      ) }}
      <div style="height:var(--space-6);"></div>

      <div class="tag-row mb-9" data-filter-group="division">
        {% for d in divisionTags %}
          {{ tag(label=d, value=d, selected=(d == "All")) }}
        {% endfor %}
      </div>

      <!-- SAMPLE DATA: replace with the real weekly schedule/results feed -->
      <div class="game-list">
        {% for game in games %}{{ gameCard(game) }}{% endfor %}
      </div>
      <div id="no-games" hidden>
        {% call card(variant="sunken") %}
        <p class="text-muted" style="text-align:center;margin:0;">No games for this division this week.</p>
        {% endcall %}
      </div>
    </div>

    <aside class="sidebar">
      {% call card(accentBar=true) %}
      <h3 style="text-transform:uppercase;">Fields</h3>
      <ul style="list-style:none;margin:0 0 var(--space-4);padding:0;font-size:var(--text-sm);">
        {% for field in site.fields %}
        <li style="margin-bottom:var(--space-3);">
          <strong>{{ field.name }}</strong><br>
          <span class="text-muted">{{ field.note }}</span>
        </li>
        {% endfor %}
      </ul>
      {{ button(label="Field status", href="/schedule/", variant="secondary", size="sm", fullWidth=true) }}
      {% endcall %}

      {% call card(variant="brand") %}
      <h3 style="text-transform:uppercase;color:var(--pg-gold);">Snack bar duty</h3>
      <p style="margin:0 0 var(--space-4);">Every family takes two shifts a season. Pick yours before they're gone.</p>
      {{ button(label="Sign up", href="/volunteer/", variant="inverse", size="sm", fullWidth=true) }}
      {% endcall %}
    </aside>
  </div>
</div>
