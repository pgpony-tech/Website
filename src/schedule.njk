---
layout: layout.njk
title: Schedule & scores
permalink: /schedule/
---
{% from "components/button.njk" import button %}
{% from "components/breadcrumbs.njk" import breadcrumbs %}
{% from "components/alert.njk" import alert %}
{% from "components/card.njk" import card %}
{% from "components/section-heading.njk" import sectionHeading %}

<div class="page-header">
  <div class="page-header__inner">
    {{ breadcrumbs([{ label: "Home", href: "/" }, { label: "Schedule" }]) }}
    <h1>Schedule &amp; scores</h1>
  </div>
</div>

<div class="container" style="padding-top:var(--space-8);padding-bottom:var(--space-12);">
  <div id="field-status"{% if not fieldStatus.message %} hidden{% endif %}>
    {% if fieldStatus.message %}
    {{ alert(title=fieldStatus.title, message=fieldStatus.message, tone=fieldStatus.tone) }}
    {% endif %}
  </div>
  <p style="margin-top:var(--space-4);">
    Want to know which fields host your division, and which have a concession stand?
    {{ button(label="View all fields", href="/fields/", variant="secondary", size="sm") }}
  </p>

  <div class="mt-11">
    {{ sectionHeading(
      eyebrow="Mark your calendar",
      title="Key dates",
      description="Registration deadlines, opening day, board meetings, and other need-to-know dates."
    ) }}
    <div id="key-dates-list" class="key-dates-list">
      <p class="text-muted">Loading key dates…</p>
    </div>
    <p style="font-size:var(--text-sm);margin-top:var(--space-4);">
      <a href="https://calendar.google.com/calendar/u/0?cid=Y19jYWNiMmZiMjY0ZTc2ZmI3ZDcxYmQ3ZWQwNDc0MzE3YmRhMDU2YzU2YmZjNTkxNzM2ODdlZjI2MTYxZWQ3NWM4QGdyb3VwLmNhbGVuZGFyLmdvb2dsZS5jb20" target="_blank" rel="noopener">View our full public calendar →</a>
    </p>
  </div>

  <div class="mt-11">
    {{ sectionHeading(
      eyebrow="Live scores",
      title="GameChanger"
    ) }}
    <p class="text-muted">Live schedules and scores are moving to GameChanger — full integration is coming soon. In the meantime, here are two scoreboards from last spring as a preview of what's ahead.</p>

    <div class="gc-widgets">
      <div>
        <span class="eyebrow">Example — spring 2026</span>
        {% call card() %}
        <iframe src="https://widgets.gc.com/scoreboard/dc212b3a-150a-44ff-82c0-1e88eff4aedc/embed/v1?source=cx" width="100%" height="250px" style="border: none; outline: none;" title="GameChanger Scoreboard" loading="lazy"></iframe>
        {% endcall %}
      </div>
      <div>
        <span class="eyebrow">Example — spring 2026</span>
        {% call card() %}
        <iframe src="https://widgets.gc.com/scoreboard/ec9572de-2a47-4c39-82c5-a1caa40b706d/embed/v1?source=cx" width="100%" height="250px" style="border: none; outline: none;" title="GameChanger Scoreboard" loading="lazy"></iframe>
        {% endcall %}
      </div>
    </div>
  </div>
</div>
